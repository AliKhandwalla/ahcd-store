# Copy to .env.local and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API Keys
#
# Both variables are NEXT_PUBLIC_, meaning they are exposed to the browser.
# Only ever put the PUBLISHABLE key here. The secret / service-role key must
# never appear in this project.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Server-only. Must NOT have the NEXT_PUBLIC_ prefix — this is the sole gate on
# the /admin area, and it must never reach the browser bundle.
# Must match the email hard-coded in supabase/schema.sql's is_ahcd_admin().
ADMIN_EMAIL=you@example.com

# --- Newsletter (Resend) -----------------------------------------------------
# All server-only. NEVER prefix any of these with NEXT_PUBLIC_, and never
# commit a real key.

# Sending key. Resend permission: "sending_access" is enough here, and is the
# right choice — this key is used on every public signup, so it should be able
# to do as little as possible.
RESEND_API_KEY=re_your_sending_key

# The verified sending identity and the address replies go to.
RESEND_FROM_EMAIL=Your Brand <newsletter@mail.example.com>
RESEND_REPLY_TO=privacy@example.com

# Subscriber management key. Resend offers only two permission levels —
# "sending_access" and "full_access" — with no contacts-only scope, so
# creating and listing contacts requires a SECOND, full-access key. The
# sending key above genuinely cannot do it: Resend replies
# "This API key is restricted to only send emails".
#
# Public signups stay disabled until this is set, because without it a visitor
# could confirm and still not become a subscriber.
RESEND_CONTACTS_API_KEY=re_your_full_access_key

# Optional emergency kill switch. Only the literal string "false" disables
# signups; leave it unset in normal operation.
# NEWSLETTER_ENABLED=false
